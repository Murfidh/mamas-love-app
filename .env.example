# Your domain, pointed at this server with an A record (used by Caddy for automatic HTTPS)
DOMAIN=app.mamasandlove.lk

# First admin account (only used the very first time the app starts)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-long-password

# Optional: long random string. Generated and stored automatically if left empty.
SESSION_SECRET=

# How long a sign-in lasts, in days
SESSION_DAYS=7
